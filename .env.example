# Copie para .env e troque TODOS os valores (ou rode: ./scripts/gerar-env.sh).
# O .env real NÃO é versionado (.gitignore). É dele que saem os Secrets do K8s.

# Bancos (um usuário/senha por serviço)
DOADORES_DB_PASSWORD=troque-me
COMUNIDADES_DB_PASSWORD=troque-me
MOBILIZACOES_DB_PASSWORD=troque-me
INFORMACOES_DB_PASSWORD=troque-me

# Broker
RABBITMQ_USER=4life
RABBITMQ_PASSWORD=troque-me

# Gateway (mínimo de 32 caracteres)
JWT_SECRET=troque-me-por-um-segredo-com-pelo-menos-32-caracteres

# Opcionais
GATEWAY_PORT=8080
LOG_LEVEL=info
