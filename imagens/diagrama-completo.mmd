flowchart TB
    subgraph CLI["Clientes"]
        direction LR
        APP["📱 App mobile"]
        WEB["🖥️ Aplicação web<br/>(doadores e admins)"]
    end

    subgraph K8S["Cluster Kubernetes (kind) · namespace 4life · NetworkPolicy default-deny-ingress"]
        direction TB

        subgraph EDGE["Borda"]
            direction LR
            ING["Ingress 4life · host 4life.test<br/>/api · /auth · /health"]
            GWSVC["Service gateway<br/>:8080"]
            GW["API Gateway · 2 réplicas<br/>valida JWT · roteia /api/mobile e /api/web<br/>esconde /auth interno · sanitiza (..)<br/>/assistente com timeout de 55 s<br/>rate limiting 📐"]
        end

        subgraph BFFS["Camada BFF (sem banco)"]
            direction LR
            BM["bff-mobile · :4001 · HPA 2→5<br/>GET /inicio agrega 3 serviços<br/>assistente com resposta enxuta"]
            BW["bff-web · :4002 · 2 réplicas<br/>GET /comunidades/{id} = painel CQRS<br/>cria mobilização → 202 + /saga<br/>valida admin antes da saga"]
        end

        subgraph DOM["Serviços de domínio (database per service · Transactional Outbox + relay em todos)"]
            direction LR

            subgraph DOA["doadores-service · :3001 · 2 réplicas"]
                direction TB
                DOA_R["Rotas /doadores<br/>/auth/verificar"]
                DOA_RL["Outbox relay<br/>doador.cadastrado / atualizado"]
            end

            subgraph COM["comunidades-service · :3002 · 2 réplicas"]
                direction TB
                COM_R["Rotas /comunidades /membros<br/>modelo de ESCRITA"]
                COM_C["Consumidor idempotente<br/>contador de mobilizações"]
                COM_P["Projeção do painel<br/>(eventos → documento)"]
                COM_Q["Leitura CQRS<br/>GET /comunidades/{id}/painel"]
                COM_SP["Participante SAGA<br/>T2 reservar-data / C2"]
            end

            subgraph MOB["mobilizacoes-service · :3003 · 1→3 réplicas"]
                direction TB
                MOB_R["Rotas /mobilizacoes (202)<br/>/saga · /interesses"]
                ORQ["🎯 Orquestrador da SAGA<br/>T1 PENDENTE · T4 CONFIRMADA<br/>timeout 30 s · C3→C2→C1"]
                OUTBOX[("tabela outbox")]
                RELAY["Outbox relay<br/>SKIP LOCKED + confirm"]
            end

            subgraph INF["informacoes-service · :3004 · 2 réplicas"]
                direction TB
                INF_R["Rotas /conteudos /faq<br/>/hemocentros"]
                INF_SP["Participante SAGA<br/>T3 reservar-janela (pivô) / C3"]
                INF_AI["🤖 Assistente (LangChain)<br/>RAG + tools · circuit breaker<br/>timeout/retry · cache · fallback"]
            end
        end

        subgraph LLM["LLM local · Ollama + PVC dos modelos"]
            OLL["Ollama :11434<br/>qwen2.5:0.5b · bge-m3"]
        end

        subgraph BUS["RabbitMQ · StatefulSet + PVC 1Gi · :5672"]
            direction LR
            EX{{"Exchange topic<br/>4life.events"}}
            Q1[["comunidades.<br/>mobilizacao-criada"]]
            QP[["comunidades.painel"]]
            Q2[["saga.comunidades.comandos<br/>saga.informacoes.comandos"]]
            QR[["saga.mobilizacoes.<br/>respostas"]]
        end

        subgraph DATA["PostgreSQL 16 · um StatefulSet + PVC 1Gi por serviço"]
            direction LR
            DOA_DB[("doadores-db<br/>+ outbox")]
            COM_DB[("comunidades-db<br/>+ reservas_calendario<br/>+ painel_comunidade")]
            MOB_DB[("mobilizacoes-db<br/>+ sagas · saga_historico")]
            INF_DB[("informacoes-db · pgvector<br/>+ reservas_hemocentro<br/>+ rag_trechos · cache")]
        end

        LEG["<b>Legenda</b><br/>── HTTP síncrono · ┄┄ RabbitMQ assíncrono · ━━ SQL<br/>verde = já existia · laranja = Parte 4<br/>amarelo tracejado 📐 = planejado · cinza = infraestrutura"]
        CFG["⚙️ ConfigMaps (URLs, portas, LOG_LEVEL, SAGA_TIMEOUT_MS, modelos do LLM) e Secrets<br/>(*-db-credentials, rabbitmq-credentials, gateway-jwt) montados nos Deployments e StatefulSets"]
    end

    %% síncrono
    APP --> ING
    WEB --> ING
    ING --> GWSVC --> GW
    GW -->|/api/mobile| BM
    GW -->|/api/web · /auth/login| BW
    BM --> DOA & COM & MOB & INF
    BW --> DOA & COM & MOB & INF

    %% interno
    MOB_R -->|T1| ORQ
    ORQ --> OUTBOX --> RELAY
    COM_P --> COM_Q
    INF_AI -->|chat · tools · embeddings| OLL

    %% bancos: cada serviço só acessa o próprio
    DOA ==> DOA_DB
    COM ==> COM_DB
    MOB ==> MOB_DB
    INF ==> INF_DB

    %% assíncrono
    DOA_RL -.->|doador.*| EX
    RELAY -.->|mobilizacao.* · comandos| EX
    EX -.-> Q1
    EX -.-> QP
    EX -.-> Q2
    EX -.-> QR
    Q1 ~~~ DOA_DB
    Q2 ~~~ MOB_DB
    COM_C <-.->|consome| Q1
    COM_P <-.->|consome| QP
    COM_SP <-.->|reservar-data / resposta| Q2
    INF_SP <-.->|reservar-janela / resposta| Q2
    ORQ <-.->|respostas| QR

    classDef impl fill:#e6f4ea,stroke:#2e7d32,color:#1b1b1b
    classDef p4 fill:#fde9d9,stroke:#d84315,color:#1b1b1b
    classDef alvo fill:#fff8e1,stroke:#f9a825,stroke-dasharray:5 4,color:#1b1b1b
    classDef infra fill:#eceff1,stroke:#546e7a,color:#1b1b1b
    classDef orq fill:#fde9d9,stroke:#d84315,stroke-width:3px,color:#1b1b1b
    classDef leg fill:#ffffff,stroke:#546e7a,color:#1b1b1b,text-align:left

    class APP,WEB,GW,BM,BW,DOA_R,COM_R,COM_C,MOB_R,OUTBOX,INF_R,EX,Q1,DOA_DB,COM_DB,MOB_DB,INF_DB impl
    class DOA_RL,COM_P,COM_Q,COM_SP,RELAY,INF_SP,INF_AI,OLL,QP,Q2,QR p4
    class ORQ orq
    class ING,GWSVC,CFG infra
    class LEG leg
